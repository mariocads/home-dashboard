# Kopieren nach .env (wird NIE eingecheckt) und Werte setzen.

# Image-Tag aus GHCR: main (neuester Stand), sha-<kurz> oder Version (z. B. 0.1.0)
TAG=main

# Langes, zufälliges Passwort, z. B.: openssl rand -base64 32
POSTGRES_PASSWORD=bitte-aendern

# Hostname des ThinkCentre in der FRITZ!Box. NICHT mehr ändern, sobald Passkeys registriert sind.
ORIGIN=https://home.fritz.box
RP_ID=home.fritz.box

# Optional: Adresse des AMIS-Lesers (Standard http://amis-1.fritz.box/rest). Leer lassen = Adapter aus.
# Falls der Name im Container nicht auflöst, die feste IP aus der FRITZ!Box eintragen.
# AMIS_URL=http://amis-1.fritz.box/rest

# Optional: Timescale-Image fixieren
# TIMESCALE_TAG=latest-pg16

# Optional für backup.sh: externes restic-Ziel (USB-Platte, NAS)
# RESTIC_REPOSITORY=/mnt/backup/home-dashboard
# RESTIC_PASSWORD=...
