# Kopieren nach .env (wird NIE eingecheckt) und Werte setzen.

# Image-Tag aus GHCR: main (neuester Stand), sha-<kurz> oder Version (z. B. 0.1.0)
TAG=main

# Langes, zufälliges Passwort, z. B.: openssl rand -base64 32
POSTGRES_PASSWORD=bitte-aendern

# Hostname des Servers in der FRITZ!Box. NICHT mehr ändern, sobald Passkeys registriert sind.
# Bei einem Umzug wandert der Name auf den neuen Server (docs/BETRIEB.md, Abschnitt 8).
ORIGIN=https://home-server.fritz.box
RP_ID=home-server.fritz.box

# Optional: Adresse des AMIS-Lesers (Standard http://amis-1.fritz.box/rest). Leer lassen = Adapter aus.
# Falls der Name im Container nicht auflöst, die feste IP aus der FRITZ!Box eintragen.
# AMIS_URL=http://amis-1.fritz.box/rest

# Optional: Adresse der Stiebel ISG der Wärmepumpe (Standard servicewelt.fritz.box, Modbus TCP Port 502).
# Leer lassen = Adapter aus. Am besten die feste IP aus der FRITZ!Box eintragen.
# ISG_HOST=servicewelt.fritz.box

# Optional: feste IP der go-e Wallbox. In der go-e-App muss die lokale HTTP API v2 aktiviert sein.
# Ohne Eintrag ist der Adapter aus.
# GOE_HOST=192.168.178.x

# Timescale-Image fixieren (nach dem ersten Start, siehe docs/BETRIEB.md). Ein Restore
# auf einem anderen Server braucht dieselbe Version.
# TIMESCALE_TAG=latest-pg16

# Optional für backup.sh: externes restic-Ziel (USB-Platte, NAS)
# RESTIC_REPOSITORY=/mnt/backup/home-dashboard
# RESTIC_PASSWORD=...
