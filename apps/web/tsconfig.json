{
  "extends": "$app/tsconfig",
  "include": ["src", "test", "scripts", "*"],
  "exclude": ["src/service-worker"],
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node", "$app/types"]
  }
}
